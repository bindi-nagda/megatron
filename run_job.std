#!/bin/bash
#SBATCH --job-name=expt 
#SBATCH --output=data.%J.out
#SBATCH --error=data.%J.err
#SBATCH --nodes=1 
#SBATCH --ntasks=1
#SBATCH --mem=40000MB
#SBATCH --partition=gpu2
#SBATCH --gres=gpu:1
#SBATCH --nodelist=gpu06
 
# === Load and Activate Conda ===
# Initialize Conda manually (important in SLURM non-interactive jobs)
# source <path-to-minconda>/etc/profile.d/conda.sh
source /<your-path>/miniconda3/etc/profile.d/conda.sh
conda activate meta310  

# === Debug Info ===
echo "SLURM Job started on: $(date)"
echo "Running on node: $(hostname)"
echo "CUDA_VISIBLE_DEVICES: $CUDA_VISIBLE_DEVICES"
echo "Python path: $(which python)"
echo "Python version: $(python --version)"
# echo "CUDA version: $(nvcc --version)"
# echo "Environment PATH: $PATH"
echo "-----------------------------"

# === Run training script ===
# python utils/prep_data.py
# python train/meta_train.py
python /<your-path>/megatron/train/meta_train.py --data_folder $DATA_FOLDER

wait  

# === Job End ===
echo "-----------------------------"
echo "SLURM Job ended on: $(date)"
